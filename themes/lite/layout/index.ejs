<style>
#giscus-wrap{display:none;box-sizing:border-box;max-width:880px;margin:1.5rem auto 3rem;padding:0 1rem;}
#giscus-wrap.on{display:block;}
#giscus-wrap iframe{max-height:640px;}
</style>
<div id="giscus-wrap"></div>
<script>
(function(){
  var CFG={
    repo:"Nolan539/Nolan539.github.io",
    repoId:"R_kgDOVnECkQ",
    category:"Announcements",
    categoryId:"DIC_kwDOVnECkc4DKqWS",
    mapping:"url",
    strict:"0",
    reactionsEnabled:"1",
    emitMetadata:"0",
    inputPosition:"bottom",
    theme:"preferred_color_scheme",
    lang:"zh-CN"
  };
  var wrap=document.getElementById("giscus-wrap");
  function postPage(){ return /^#\/posts\//.test(location.hash||""); }
  function place(){
    var art=document.getElementById("detailable-content");
    if(art && art.parentNode && art.nextSibling!==wrap){ art.parentNode.insertBefore(wrap, art.nextSibling); }
    return !!art;
  }
  function ensurePlaced(cb){
    if(place()){ cb(); return; }
    var n=0, timer=setInterval(function(){
      n++;
      if(place() || n>=25){ clearInterval(timer); cb(); }
    },120);
  }
  function build(){
    wrap.innerHTML="";
    var s=document.createElement("script");
    s.src="https://giscus.app/client.js";
    s.setAttribute("data-repo",CFG.repo);
    s.setAttribute("data-repo-id",CFG.repoId);
    s.setAttribute("data-category",CFG.category);
    s.setAttribute("data-category-id",CFG.categoryId);
    s.setAttribute("data-mapping",CFG.mapping);
    s.setAttribute("data-strict",CFG.strict);
    s.setAttribute("data-reactions-enabled",CFG.reactionsEnabled);
    s.setAttribute("data-emit-metadata",CFG.emitMetadata);
    s.setAttribute("data-input-position",CFG.inputPosition);
    s.setAttribute("data-theme",CFG.theme);
    s.setAttribute("data-lang",CFG.lang);
    s.crossOrigin="anonymous";
    s.async=true;
    wrap.appendChild(s);
  }
  function show(){
    wrap.classList.add("on");
    ensurePlaced(function(){ build(); });
  }
  function hide(){ wrap.classList.remove("on"); wrap.innerHTML=""; }
  window.addEventListener("hashchange",function(){ if(postPage()){ show(); } else { hide(); } });
  if(postPage()){ show(); } else { hide(); }
})();
</script>
</body></html>